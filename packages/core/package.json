{
  "name": "@ares/core",
  "description": "ARES Volumetric runtime: .ares container demux, meshopt geometry + Gaussian splat decode, WebGPU/WebGL2 renderers, WebCodecs texture, AresPlayer",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gantasmo/ARES-Volumetric.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/gantasmo/ARES-Volumetric#readme",
  "bugs": {
    "url": "https://github.com/gantasmo/ARES-Volumetric/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "keywords": [
    "volumetric",
    "volumetric-video",
    "gaussian-splatting",
    "webgpu",
    "webcodecs",
    "meshopt",
    "4d"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./decode-worker": {
      "types": "./dist/decode-worker.d.ts",
      "import": "./dist/decode-worker.js",
      "default": "./dist/decode-worker.js"
    },
    "./bundle/*": "./dist/bundle/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b && node ../../tools/bundle.mjs"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.71",
    "meshoptimizer": "^1.2.0"
  },
  "devDependencies": {}
}
