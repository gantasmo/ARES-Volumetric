{
  "name": "@ares/react",
  "description": "ARES Volumetric for @react-three/fiber: <Ares/> component",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gantasmo/ares.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "keywords": [
    "volumetric",
    "react",
    "react-three-fiber",
    "gaussian-splatting"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160",
    "@react-three/fiber": ">=8"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": false
    }
  },
  "dependencies": {
    "@ares/three": "0.1.0"
  },
  "devDependencies": {
    "react": "^19.2.7",
    "@types/react": "^19.2.17",
    "three": "^0.185.1",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.185.1"
  }
}
