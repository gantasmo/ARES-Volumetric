{
  "name": "@ares/three",
  "description": "ARES Volumetric for Three.js: AresObject wrapper around AresPlayer",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gantasmo/ARES-Volumetric.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/gantasmo/ARES-Volumetric#readme",
  "bugs": {
    "url": "https://github.com/gantasmo/ARES-Volumetric/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "keywords": [
    "volumetric",
    "three",
    "threejs",
    "gaussian-splatting"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bundle/*": "./dist/bundle/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b && node ../../tools/bundle.mjs"
  },
  "peerDependencies": {
    "three": ">=0.160"
  },
  "dependencies": {
    "@ares/core": "0.1.0"
  },
  "devDependencies": {
    "three": "^0.185.1",
    "@types/three": "^0.185.1"
  }
}
