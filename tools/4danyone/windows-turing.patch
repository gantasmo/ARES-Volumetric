diff --git a/fdanyone/precision.py b/fdanyone/precision.py
new file mode 100644
index 0000000..25214da
--- /dev/null
+++ b/fdanyone/precision.py
@@ -0,0 +1,84 @@
+"""Compute dtypes and the second DiT device (ARES patch for GPUs without native bfloat16).
+
+Environment:
+  FDANYONE_DIT_DTYPE     bfloat16 (default) | float16 | float32: DiT and pose encoder weights and
+                         autocast. Turing (sm_75) has no bf16 tensor cores; float16 runs there.
+  FDANYONE_VAE_DTYPE     bfloat16 (default) | float16 | float32: Wan VAE weights and autocast.
+  FDANYONE_SPLIT_DEVICE  e.g. cuda:1: the second half of the DiT blocks lives there, so two
+                         11 GB cards hold the 5B DiT between them. Activations follow the blocks.
+CPU-side feature banks stay bfloat16 as the release stores them; they are cast on the way in.
+"""
+
+from __future__ import annotations
+
+import os
+
+_NAMES = ("bfloat16", "float16", "float32")
+
+
+def _dtype(variable: str):
+    import torch
+
+    name = os.environ.get(variable, "bfloat16").strip().lower()
+    if name not in _NAMES:
+        raise ValueError(f"{variable}={name!r}; expected one of {', '.join(_NAMES)}")
+    return getattr(torch, name)
+
+
+def dit_dtype():
+    return _dtype("FDANYONE_DIT_DTYPE")
+
+
+def vae_dtype():
+    return _dtype("FDANYONE_VAE_DTYPE")
+
+
+def autocast(dtype):
+    import torch
+
+    return torch.autocast(device_type="cuda", dtype=dtype, enabled=dtype != torch.float32)
+
+
+def split_at(blocks: int) -> int:
+    """Index of the first block on the second device. Fewer blocks on the first card leaves it
+    room for the activations, which are the same size on both."""
+    value = os.environ.get("FDANYONE_SPLIT_AT", "").strip()
+    return max(1, min(blocks - 1, int(value))) if value else blocks // 2
+
+
+def split_device() -> str | None:
+    value = os.environ.get("FDANYONE_SPLIT_DEVICE", "").strip()
+    return value or None
+
+
+def _to_device(value, device):
+    import torch
+
+    if isinstance(value, torch.Tensor):
+        return value.to(device, non_blocking=True)
+    if isinstance(value, tuple):
+        return tuple(_to_device(v, device) for v in value)
+    if isinstance(value, list):
+        return [_to_device(v, device) for v in value]
+    return value
+
+
+def _follow_hook(module, args, kwargs):
+    """Forward pre-hook: move every tensor argument to the module's own device."""
+
+    device = next(module.parameters()).device
+    return _to_device(args, device), _to_device(kwargs, device)
+
+
+def split_dit(model, primary, secondary: str) -> None:
+    """Place blocks[len/2:] on `secondary`; everything else stays on `primary`. Idempotent."""
+
+    blocks = model.blocks
+    half = split_at(len(blocks))
+    for block in blocks[half:]:
+        block.to(secondary)
+    if not getattr(model, "_ares_split_hooks", False):
+        for block in blocks:
+            block.register_forward_pre_hook(_follow_hook, with_kwargs=True)
+        model.head.register_forward_pre_hook(_follow_hook, with_kwargs=True)
+        model._ares_split_hooks = True
